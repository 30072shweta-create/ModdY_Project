# ===================================================================
# Flight Booking Backend - Environment Variable Template (.env.example)
# ===================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit the real '.env' file containing secrets to version control.
# ===================================================================

# -------------------------------------------------------------------
# PostgreSQL Database Configuration
# -------------------------------------------------------------------

# PostgreSQL JDBC Connection URL.
# Where to get: Your local or remote PostgreSQL database instance host, port, and database name.
# Required: Yes
# Format: jdbc:postgresql://<host>:<port>/<dbname>
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/Flight

# PostgreSQL Username.
# Where to get: Configured user in your local PostgreSQL database.
# Required: Yes
# Format: String (e.g. postgres)
SPRING_DATASOURCE_USERNAME=your_postgres_username

# PostgreSQL Password.
# Where to get: Password set for your PostgreSQL database user.
# Required: Yes
# Format: Plaintext password
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# -------------------------------------------------------------------
# Server Network Configuration
# -------------------------------------------------------------------

# HTTP Port for Spring Boot Application.
# Where to get: Free port on your system.
# Required: Optional (Defaults to 8080)
# Format: Integer (e.g. 8080)
SERVER_PORT=8080

# -------------------------------------------------------------------
# SMTP Email Configuration (Gmail / Mail Provider)
# -------------------------------------------------------------------

# SMTP Mail Server Host.
# Where to get: Your email provider's SMTP host setting.
# Required: Yes (for sending OTP / notification emails)
# Format: Hostname (e.g. smtp.gmail.com)
SPRING_MAIL_HOST=smtp.gmail.com

# SMTP Server Port.
# Where to get: Standard TLS/SSL port provided by your email service.
# Required: Yes
# Format: Integer (e.g. 587 for TLS, 465 for SSL)
SPRING_MAIL_PORT=587

# SMTP Account Email Address.
# Where to get: The email address used to send system emails.
# Required: Yes
# Format: Valid email address (e.g. user@example.com)
SPRING_MAIL_USERNAME=your_email@example.com

# SMTP Password / Gmail App Password.
# Where to get: Generated App Password from Google Account Security settings (Security -> 2-Step Verification -> App Passwords).
# IMPORTANT: Use an APP PASSWORD, NOT your normal personal account password.
# Required: Yes
# Format: 16-character app password (e.g. abcd efgh ijkl mnop)
SPRING_MAIL_PASSWORD=your_gmail_app_password

# -------------------------------------------------------------------
# JWT (JSON Web Token) Security Configuration
# -------------------------------------------------------------------

# Secret key used to sign and verify JWT access tokens.
# Where to get: Generate a long, cryptographically secure random string (minimum 256 bits / 32 bytes).
# Required: Yes
# Format: Hexadecimal or Base64 encoded secret string
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Access token validity duration in milliseconds.
# Where to get: Application security policy requirement.
# Required: Optional (Defaults to 900000 = 15 minutes)
# Format: Integer in milliseconds (e.g. 900000)
JWT_ACCESS_EXPIRATION=900000

# Refresh token validity duration in milliseconds.
# Where to get: Application security policy requirement.
# Required: Optional (Defaults to 604800000 = 7 days)
# Format: Integer in milliseconds (e.g. 604800000)
JWT_REFRESH_EXPIRATION=604800000

# Name of the HttpOnly cookie storing the refresh token.
# Where to get: Frontend / Backend cookie contract.
# Required: Optional (Defaults to refreshToken)
# Format: String
JWT_COOKIE_NAME=refreshToken

# Whether the refresh token cookie requires HTTPS (Secure flag).
# Where to get: Set to false for local HTTP development, true for HTTPS production.
# Required: Optional (Defaults to false)
# Format: Boolean (true / false)
JWT_COOKIE_SECURE=false

# SameSite attribute for the refresh token cookie.
# Where to get: Browser cross-site policy (Lax, Strict, or None).
# Required: Optional (Defaults to Lax)
# Format: String (Lax / Strict / None)
JWT_COOKIE_SAME_SITE=Lax

# Cookie path attribute.
# Required: Optional (Defaults to /)
# Format: String path
JWT_COOKIE_PATH=/

# -------------------------------------------------------------------
# OAuth2 / Google Authentication Configuration
# -------------------------------------------------------------------

# Google OAuth2 Client ID.
# Where to get: Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs).
# Required: Yes (for Google One-Tap / Social Login)
# Format: Client ID string ending in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# -------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# -------------------------------------------------------------------

# Allowed frontend origins permitted to access REST APIs.
# Where to get: URL of your Angular frontend or client application.
# Required: Yes
# Format: Origin URL (e.g. http://localhost:4200)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# -------------------------------------------------------------------
# Redis Cache & Seat Locking Configuration
# -------------------------------------------------------------------

# Redis server host name.
# Where to get: Local Docker container or Redis host address.
# Required: Yes
# Format: Hostname or IP (e.g. localhost)
REDIS_HOST=localhost

# Redis server port.
# Where to get: Standard Redis port.
# Required: Yes
# Format: Integer (Defaults to 6379)
REDIS_PORT=6379

# Redis authentication password.
# Where to get: Set if your Redis server requires authentication; leave empty for local unauthenticated Docker.
# Required: Optional
# Format: String (Leave empty if no password)
REDIS_PASSWORD=

# -------------------------------------------------------------------
# Flight Seat Locking Duration
# -------------------------------------------------------------------

# Temporary seat hold duration in minutes.
# Where to get: Business policy for holding a selected seat prior to payment completion.
# Required: Optional (Defaults to 10)
# Format: Integer in minutes (e.g. 10)
SEAT_LOCK_DURATION_MINUTES=10
