# PostgreSQL JDBC Connection URL.
# Where to get: Your local or remote PostgreSQL database instance host, port, and database name.
# Required: Yes
# Format: jdbc:postgresql://<host>:<port>/<dbname>
SPRING_DATASOURCE_URL=

# PostgreSQL Username.
# Where to get: Configured user in your local PostgreSQL database.
# Required: Yes
# Format: String (e.g. postgres)
SPRING_DATASOURCE_USERNAME=your_postgres_username

# PostgreSQL Password.
# Where to get: Password set for your PostgreSQL database user.
# Required: Yes
# Format: Plaintext password
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# -------------------------------------------------------------------
# Server Network Configuration
# -------------------------------------------------------------------

# HTTP Port for Spring Boot Application.
# Where to get: Free port on your system.
# Required: Optional (Defaults to 8080)
# Format: Integer (e.g. 8080)
